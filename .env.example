# === Facebook Messenger ===
FB_PAGE_ACCESS_TOKEN=your_page_access_token
FB_RECIPIENT_ID=your_recipient_psid

# === Claude AI (for generating fresh messages) ===
ANTHROPIC_API_KEY=your_anthropic_api_key

# === Weather (OpenWeatherMap — free tier) ===
OPENWEATHER_API_KEY=your_openweather_api_key
WEATHER_CITY=New York
WEATHER_UNITS=imperial

# === Scheduling ===
MIN_MESSAGES_PER_DAY=2
MAX_MESSAGES_PER_DAY=5
EARLIEST_HOUR=8
LATEST_HOUR=22

# === Web Dashboard ===
DASHBOARD_PORT=3000
# Optional: protect dashboard with a PIN
DASHBOARD_PIN=

# === Your girlfriend's name (used in AI-generated messages) ===
PARTNER_NAME=babe
# Your name
YOUR_NAME=

# === Anniversary date (YYYY-MM-DD) for day counting ===
ANNIVERSARY_DATE=2024-01-01
