# === Twilio (SMS) ===
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890
RECIPIENT_PHONE_NUMBER=+1234567890

# === Facebook Messenger ===
FB_PAGE_ACCESS_TOKEN=your_page_access_token
FB_RECIPIENT_ID=your_recipient_psid

# === Scheduling ===
# Minimum messages per day
MIN_MESSAGES_PER_DAY=1
# Maximum messages per day
MAX_MESSAGES_PER_DAY=5
# Earliest hour to send (24h format, e.g. 8 = 8:00 AM)
EARLIEST_HOUR=8
# Latest hour to send (24h format, e.g. 22 = 10:00 PM)
LATEST_HOUR=22

# === Channels ===
# Which channel to use: "sms", "messenger", or "both"
CHANNEL=sms
